{
  "name": "@liusiqi-dev/sqh-terminal-bash",
  "description": "Persistent shell PTY backend over the Siqi Harness subprocess terminal primitive",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-terminal": "workspace:*",
    "@liusiqi-dev/sqh-sandbox": "workspace:*",
    "@liusiqi-dev/sqh-sandbox-policy": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-subprocess": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@liusiqi-dev/sqh-lazy-require": "workspace:*",
    "@liusiqi-dev/sqh-pwsh-local": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop-testkit": "workspace:*",
    "@liusiqi-dev/sqh-terminal": "workspace:*",
    "@liusiqi-dev/sqh-sandbox": "workspace:*",
    "@liusiqi-dev/sqh-sandbox-policy": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-subprocess": "workspace:*",
    "@liusiqi-dev/sqh-subprocess-local": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  }
}
