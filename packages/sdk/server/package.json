{
  "name": "@liusiqi-dev/sqh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Siqi Harness SDK clients",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liusiqi-dev/sqh-brand": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-attachment": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-llm-deepseek-api-key": "workspace:*",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-sdk-protocol": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop-testkit": "workspace:*",
    "@liusiqi-dev/sqh-attachment": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-llm-deepseek-api-key": "workspace:*",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-sdk-protocol": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence-jsonl": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*"
  }
}
