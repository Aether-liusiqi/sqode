{
  "name": "@liusiqi-dev/dsh-experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-browser-use": "workspace:*",
    "@liusiqi-dev/dsh-mcp-client": "workspace:*",
    "@liusiqi-dev/dsh-scope": "workspace:*",
    "@liusiqi-dev/dsh-tools": "workspace:*",
    "@liusiqi-dev/dsh-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-browser-use": "workspace:*",
    "@liusiqi-dev/dsh-mcp-client": "workspace:*",
    "@liusiqi-dev/dsh-scope": "workspace:*",
    "@liusiqi-dev/dsh-tools": "workspace:*",
    "@liusiqi-dev/dsh-agent-loop-testkit": "workspace:*",
    "@liusiqi-dev/dsh-agent-loop": "workspace:*",
    "@liusiqi-dev/dsh-session": "workspace:*",
    "@liusiqi-dev/dsh-session-projection": "workspace:*",
    "@liusiqi-dev/dsh-system-prompt": "workspace:*",
    "@liusiqi-dev/dsh-mcp-resources": "workspace:*",
    "@liusiqi-dev/dsh-ptc-runtime": "workspace:*",
    "@liusiqi-dev/dsh-llm": "workspace:*",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/cordis-plugin-include": "workspace:~",
    "@liusiqi-dev/dsh-attachment-local": "workspace:*",
    "@liusiqi-dev/dsh-session-persistence-jsonl": "workspace:*"
  }
}
