{
  "name": "@liusiqi-dev/sqh-experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the Sqode PTC execution seam",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
