{
  "name": "@liusiqi-dev/sqh-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the Sqode",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/sqh-invariants": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-typert-protocol": "workspace:*",
    "@liusiqi-dev/sqh-util-values": "workspace:*",
    "@liusiqi-dev/sqh-workspace": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@liusiqi-dev/sqh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@liusiqi-dev/sqh-invariants": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-typert-protocol": "workspace:*",
    "@liusiqi-dev/sqh-typert-registry": "workspace:*",
    "@liusiqi-dev/sqh-util-values": "workspace:*",
    "@liusiqi-dev/sqh-workspace": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  }
}
