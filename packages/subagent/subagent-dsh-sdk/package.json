{
  "name": "@liusiqi-dev/dsh-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child DeepSeek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-llm": "workspace:*",
    "@liusiqi-dev/dsh-sdk-client": "workspace:*",
    "@liusiqi-dev/dsh-session": "workspace:*",
    "@liusiqi-dev/dsh-subagent": "workspace:*",
    "@liusiqi-dev/dsh-subprocess": "workspace:*"
  },
  "dependencies": {
    "@liusiqi-dev/dsh-brand": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-agent-instructions": "workspace:*",
    "@liusiqi-dev/dsh-app-boot": "workspace:*",
    "@liusiqi-dev/dsh-llm": "workspace:*",
    "@liusiqi-dev/dsh-llm-deepseek": "workspace:*",
    "@liusiqi-dev/dsh-llm-deepseek-api-key": "workspace:*",
    "@liusiqi-dev/dsh-loader-smoke": "workspace:*",
    "@liusiqi-dev/dsh-sdk-client": "workspace:*",
    "@liusiqi-dev/dsh-sdk-protocol": "workspace:*",
    "@liusiqi-dev/dsh-session": "workspace:*",
    "@liusiqi-dev/dsh-session-checkpoint-policy": "workspace:*",
    "@liusiqi-dev/dsh-session-persistence-jsonl": "workspace:*",
    "@liusiqi-dev/dsh-session-projection": "workspace:*",
    "@liusiqi-dev/dsh-skill-filesystem": "workspace:*",
    "@liusiqi-dev/dsh-subagent": "workspace:*",
    "@liusiqi-dev/dsh-subprocess": "workspace:*",
    "@liusiqi-dev/dsh-system-prompt": "workspace:*",
    "@liusiqi-dev/dsh-tool-subagent": "workspace:*"
  }
}
