{
  "name": "@liusiqi-dev/sqh-subagent-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Siqi Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-sdk-client": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-subprocess": "workspace:*"
  },
  "dependencies": {
    "@liusiqi-dev/sqh-brand": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-agent-instructions": "workspace:*",
    "@liusiqi-dev/sqh-app-boot": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-llm-deepseek": "workspace:*",
    "@liusiqi-dev/sqh-llm-deepseek-api-key": "workspace:*",
    "@liusiqi-dev/sqh-loader-smoke": "workspace:*",
    "@liusiqi-dev/sqh-sdk-client": "workspace:*",
    "@liusiqi-dev/sqh-sdk-protocol": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-checkpoint-policy": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence-jsonl": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-skill-filesystem": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-subprocess": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-tool-subagent": "workspace:*"
  }
}
