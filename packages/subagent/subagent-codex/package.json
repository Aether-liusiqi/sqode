{
  "name": "@liusiqi-dev/sqh-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-subprocess": "workspace:*",
    "@liusiqi-dev/sqh-timeout": "workspace:*"
  },
  "dependencies": {
    "@liusiqi-dev/sqh-brand": "workspace:*",
    "@liusiqi-dev/sqh-sdk-protocol": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~",
    "@openai/codex": "0.153.4"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-app-boot": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-loader-smoke": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-checkpoint-policy": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence-jsonl": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-subprocess": "workspace:*",
    "@liusiqi-dev/sqh-subprocess-local": "workspace:*",
    "@liusiqi-dev/sqh-timeout": "workspace:*",
    "@liusiqi-dev/sqh-tool-jobs": "workspace:*",
    "@liusiqi-dev/sqh-tool-subagent": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*"
  }
}
