{
  "name": "@liusiqi-dev/dsh-web-search-http",
  "description": "Search-engine provider (Google Custom Search, falling back to Bing) for the web capability seam (ctx.web)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/dsh-launch-environment": "workspace:*",
    "@liusiqi-dev/dsh-web": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/dsh-launch-environment": "workspace:*",
    "@liusiqi-dev/dsh-web": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  }
}
