{
  "name": "@liusiqi-dev/dsh-web-search-deepseek",
  "description": "Search provider backed by an Anthropic-compatible Messages API with native web_search, for the Siqi Harness web capability seam (ctx.web)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-credentials": "workspace:*",
    "@liusiqi-dev/dsh-deepseek-account": "workspace:*",
    "@liusiqi-dev/dsh-launch-environment": "workspace:*",
    "@liusiqi-dev/dsh-session": "workspace:*",
    "@liusiqi-dev/dsh-web": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-credentials": "workspace:*",
    "@liusiqi-dev/dsh-credentials-local": "workspace:*",
    "@liusiqi-dev/dsh-deepseek-account": "workspace:*",
    "@liusiqi-dev/dsh-launch-environment": "workspace:*",
    "@liusiqi-dev/dsh-session": "workspace:*",
    "@liusiqi-dev/dsh-web": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/dsh-http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liusiqi-dev/dsh-deepseek-account": {
      "optional": true
    }
  }
}
