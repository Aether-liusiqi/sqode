{
  "name": "@liusiqi-dev/sqh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Sqode web capability seam (ctx.web)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*",
    "@liusiqi-dev/sqh-web": "workspace:*"
  },
  "dependencies": {
    "@liusiqi-dev/sqh-util-values": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-spill-local": "workspace:*",
    "@liusiqi-dev/sqh-spill-policy": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-tool-call-timeout-policy": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*",
    "@liusiqi-dev/sqh-web": "workspace:*",
    "@liusiqi-dev/sqh-web-fetch-http": "workspace:*",
    "@liusiqi-dev/sqh-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-token-meter": "workspace:*"
  }
