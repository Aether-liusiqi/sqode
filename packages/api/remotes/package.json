{
  "name": "@liusiqi-dev/sqh-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@liusiqi-dev/sqh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@liusiqi-dev/sqh-deque": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-scope": "workspace:*"
  },
  "devDependencies": {
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-agent-preset-registry": "workspace:*",
    "@liusiqi-dev/sqh-api-gateway": "workspace:*",
    "@liusiqi-dev/sqh-api-job-controller": "workspace:*",
    "@liusiqi-dev/sqh-api-session-controller": "workspace:*",
    "@liusiqi-dev/sqh-api-settings-controller": "workspace:*",
    "@liusiqi-dev/sqh-api-workspace-controller": "workspace:*",
    "@liusiqi-dev/sqh-api-workspace-files": "workspace:*",
    "@liusiqi-dev/sqh-client-connection": "workspace:*",
    "@liusiqi-dev/sqh-client-file-upload": "workspace:*",
    "@liusiqi-dev/sqh-commands": "workspace:*",
    "@liusiqi-dev/sqh-cordis-host-runner": "workspace:*",
    "@liusiqi-dev/sqh-credentials": "workspace:*",
    "@liusiqi-dev/sqh-file-reference": "workspace:*",
    "@liusiqi-dev/sqh-goal": "workspace:*",
    "@liusiqi-dev/sqh-host-plugin-inventory": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-message-feedback": "workspace:*",
    "@liusiqi-dev/sqh-permission-presets": "workspace:*",
    "@liusiqi-dev/sqh-schedule": "workspace:*",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-session-reference": "workspace:*",
    "@liusiqi-dev/sqh-settings": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-typert-protocol": "workspace:*",
    "@liusiqi-dev/sqh-user-approval": "workspace:*",
    "@liusiqi-dev/sqh-user-questions": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~",
    "zod": "^4.4.3",
    "@liusiqi-dev/sqh-command-feedback": "workspace:*",
    "@liusiqi-dev/sqh-api-terminal-controller": "workspace:*",
    "@liusiqi-dev/sqh-plugin-manager": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-plugin-manager": "workspace:*",
    "@liusiqi-dev/sqh-office-to-pdf": "workspace:*",
    "@liusiqi-dev/sqh-api-account-controller": "workspace:*",
    "@liusiqi-dev/sqh-deepseek-account": "workspace:*",
    "@liusiqi-dev/sqh-client-product-analytics": "workspace:*"
  }
}
