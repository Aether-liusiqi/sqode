    "@liusiqi-dev/sqh-client-file-upload": "workspace:*",
    "@liusiqi-dev/sqh-commands": "workspace:*",
    "@liusiqi-dev/sqh-credentials": "workspace:*",
    "@liusiqi-dev/sqh-file-reference": "workspace:*",
    "@liusiqi-dev/sqh-fs": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-native-command": "workspace:*",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-session-projection-cache": "workspace:*",
    "@liusiqi-dev/sqh-session-query": "workspace:*",
    "@liusiqi-dev/sqh-session-title": "workspace:*",
    "@liusiqi-dev/sqh-settings": "workspace:*",
    "@liusiqi-dev/sqh-skill": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-typert-protocol": "workspace:*",
    "@liusiqi-dev/sqh-typert-registry": "workspace:*",
    "@liusiqi-dev/sqh-util-time": "workspace:*",
    "@liusiqi-dev/sqh-util-values": "workspace:*",
    "@liusiqi-dev/sqh-util-workspace-path": "workspace:*",
    "@liusiqi-dev/sqh-workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
