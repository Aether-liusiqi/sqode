{
  "name": "@liusiqi-dev/sqh-acp",
  "description": "Automation-only Agent Client Protocol server for driving Sqode agents over JSON-RPC stdio",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@liusiqi-dev/sqh-brand": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-attachment": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-mcp-client": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence": "workspace:*",
    "@liusiqi-dev/sqh-token-meter": "workspace:*",
    "@liusiqi-dev/sqh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liusiqi-dev/sqh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop-testkit": "workspace:*",
    "@liusiqi-dev/sqh-attachment": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-mcp-client": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence-jsonl": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-token-meter": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*",
    "@liusiqi-dev/sqh-user-approval": "workspace:*"
  }
}
