{
  "name": "@liusiqi-dev/dsh-tool-present",
  "description": "Explicit workspace file delivery declarations for the Siqi Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/deliverables/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-fs": "workspace:*",
    "@liusiqi-dev/dsh-llm": "workspace:*",
    "@liusiqi-dev/dsh-session": "workspace:*",
    "@liusiqi-dev/dsh-session-projection": "workspace:*",
    "@liusiqi-dev/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/dsh-agent": "workspace:*",
    "@liusiqi-dev/dsh-fs": "workspace:*",
    "@liusiqi-dev/dsh-llm": "workspace:*",
    "@liusiqi-dev/dsh-session": "workspace:*",
    "@liusiqi-dev/dsh-session-projection": "workspace:*",
    "@liusiqi-dev/dsh-tools": "workspace:*",
    "@liusiqi-dev/dsh-agent-loop": "workspace:*",
    "@liusiqi-dev/dsh-agent-loop-testkit": "workspace:*",
    "@liusiqi-dev/dsh-fs-local": "workspace:*",
    "@liusiqi-dev/dsh-system-prompt": "workspace:*",
    "@liusiqi-dev/dsh-scope": "workspace:*"
  }
}
