{
  "name": "@liusiqi-dev/dsh-typert-loader",
  "description": "Loader integration for generated Typert package contributions",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/typert/loader"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/dsh-typert-registry": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/dsh-app-boot": "workspace:*",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/dsh-typert-registry": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~",
    "zod": "^4.6.5"
  }
}
