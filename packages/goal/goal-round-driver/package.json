{
  "name": "@liusiqi-dev/sqh-goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-goal": "workspace:*",
    "@liusiqi-dev/sqh-invariants": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop-testkit": "workspace:*",
    "@liusiqi-dev/sqh-goal": "workspace:*",
    "@liusiqi-dev/sqh-invariants": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-session-projection": "workspace:*"
  }
}
