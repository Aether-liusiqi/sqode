{
  "name": "@liusiqi-dev/sqh-client-ui-schedule",
  "description": "Host task management page and Session reminder catalog",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@liusiqi-dev/sqh-api-remotes",
        "@liusiqi-dev/sqh-api-session-controller",
        "@liusiqi-dev/sqh-api-workspace-controller",
        "@liusiqi-dev/sqh-client-connection",
        "@liusiqi-dev/sqh-client-locale",
        "@liusiqi-dev/sqh-client-ui-conversation",
        "@liusiqi-dev/sqh-client-ui-layout",
        "@liusiqi-dev/sqh-client-ui-sidebar",
        "@liusiqi-dev/sqh-client-ui-sidebar-right",
        "@liusiqi-dev/sqh-client-ui-tool",
        "@liusiqi-dev/sqh-client-ui-workspace",
        "@liusiqi-dev/sqh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-schedule"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/sqh-api-remotes": "workspace:*",
    "@liusiqi-dev/sqh-api-session-controller": "workspace:*",
    "@liusiqi-dev/sqh-api-workspace-controller": "workspace:*",
    "@liusiqi-dev/sqh-client-connection": "workspace:*",
    "@liusiqi-dev/sqh-client-locale": "workspace:*",
    "@liusiqi-dev/sqh-client-test-runtime": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-conversation": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-layout": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-primitives": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-renderer": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-session": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-sidebar": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-sidebar-right": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-slots": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-tool": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-workspace": "workspace:*",
    "@liusiqi-dev/sqh-schedule": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-util-values": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.1.1",
    "@liusiqi-dev/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
