{
  "name": "@liusiqi-dev/sqh-client-ui-sidebar-terminal",
  "description": "Interactive shell tabs for the right Sidebar",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@liusiqi-dev/sqh-api-terminal-controller",
        "@liusiqi-dev/sqh-client-ui-sidebar-right",
        "@liusiqi-dev/sqh-api-remotes",
        "@liusiqi-dev/sqh-client-ui-theme",
        "@liusiqi-dev/sqh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-api-remotes": "workspace:*",
    "@liusiqi-dev/sqh-client-locale": "workspace:*",
    "@liusiqi-dev/sqh-client-store": "workspace:*",
    "@liusiqi-dev/sqh-client-test-runtime": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-dockkit": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-primitives": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-renderer": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-session": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-sidebar-right": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-slots": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "react-dom": "^18.2.0",
    "@liusiqi-dev/sqh-api-terminal-controller": "workspace:*",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@liusiqi-dev/sqh-client-ui-layout": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-conversation": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-theme": "workspace:*",
    "@liusiqi-dev/sqh-client-shortcuts": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ]
}
