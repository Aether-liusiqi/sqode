{
  "name": "@liusiqi-dev/sqh-client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@liusiqi-dev/sqh-api-session-controller",
        "@liusiqi-dev/sqh-client-file-upload",
        "@liusiqi-dev/sqh-client-locale",
        "@liusiqi-dev/sqh-client-ui-layout",
        "@liusiqi-dev/sqh-client-ui-renderer",
        "@liusiqi-dev/sqh-client-ui-session",
        "@liusiqi-dev/sqh-client-ui-settings",
        "@liusiqi-dev/sqh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-api-remotes": "workspace:*",
    "@liusiqi-dev/sqh-api-session-controller": "workspace:*",
    "@liusiqi-dev/sqh-api-workspace-controller": "workspace:*",
