    "@liusiqi-dev/sqh-workspace": "workspace:*",
    "@liusiqi-dev/sqh-file-reference": "workspace:*",
    "@liusiqi-dev/sqh-util-workspace-path": "workspace:*",
    "@types/react": "~18.3.1",
