{
  "name": "@liusiqi-dev/sqh-client-ui-settings-account",
  "description": "Manage DeepSeek login and open Platform billing pages",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@liusiqi-dev/sqh-api-remotes",
        "@liusiqi-dev/sqh-client-locale",
        "@liusiqi-dev/sqh-client-ui-chat",
        "@liusiqi-dev/sqh-client-ui-layout",
        "@liusiqi-dev/sqh-client-ui-settings",
        "@liusiqi-dev/sqh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-api-remotes": "workspace:*",
    "@liusiqi-dev/sqh-client-locale": "workspace:*",
    "@liusiqi-dev/sqh-client-store": "workspace:*",
    "@liusiqi-dev/sqh-client-test-runtime": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-chat": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-layout": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-primitives": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-renderer": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-settings": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-slots": "workspace:*",
    "@liusiqi-dev/sqh-client-ui-theme": "workspace:*",
    "@liusiqi-dev/sqh-deepseek-account": "workspace:*",
    "@liusiqi-dev/sqh-settings": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/big.js": "^6.2.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@liusiqi-dev/sqh-client-ui-settings-models": "workspace:*",
    "@types/react-dom": "~18.3.0",
    "@liusiqi-dev/sqh-host-webserver": "workspace:*",
    "big.js": "^7.0.1",
    "@liusiqi-dev/sqh-client-product-analytics": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  }
}
