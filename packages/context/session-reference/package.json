{
  "name": "@liusiqi-dev/sqh-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@liusiqi-dev/sqh-brand": "workspace:*",
    "@liusiqi-dev/sqh-util-values": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-compaction": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-output-retention": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-session-projection-cache": "workspace:*",
    "@liusiqi-dev/sqh-session-query": "workspace:*",
    "@liusiqi-dev/sqh-session-title": "workspace:*",
    "@liusiqi-dev/sqh-spill": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liusiqi-dev/sqh-spill": {
      "optional": true
    },
    "@liusiqi-dev/sqh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/cordis-plugin-include": "workspace:~",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-compaction": "workspace:*",
    "@liusiqi-dev/sqh-fs-local": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-output-retention": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-session-projection-cache": "workspace:*",
    "@liusiqi-dev/sqh-session-query": "workspace:*",
    "@liusiqi-dev/sqh-session-query-sqlite": "workspace:*",
    "@liusiqi-dev/sqh-session-title": "workspace:*",
    "@liusiqi-dev/sqh-spill": "workspace:*",
    "@liusiqi-dev/sqh-subagent": "workspace:*",
    "@liusiqi-dev/sqh-spill-local": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-tool-fs": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*",
    "@liusiqi-dev/sqh-typert-protocol": "workspace:*"
  }
}
