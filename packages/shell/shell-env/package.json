    "@liusiqi-dev/sqh-shell": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*"
  },
  "dependencies": {
    "@liusiqi-dev/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-app-boot": "workspace:*",
    "@liusiqi-dev/sqh-home-paths": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-shell": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*"
  }
}
