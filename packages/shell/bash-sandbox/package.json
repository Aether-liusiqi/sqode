{
  "name": "@liusiqi-dev/dsh-bash-sandbox",
  "description": "Sandbox-consuming implementation of the Siqi Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@liusiqi-dev/dsh-shell": "workspace:*",
    "@liusiqi-dev/dsh-bash-local": "workspace:*",
    "@liusiqi-dev/dsh-sandbox": "workspace:*",
    "@liusiqi-dev/dsh-sandbox-policy": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/dsh-shell": "workspace:*",
    "@liusiqi-dev/dsh-bash-local": "workspace:*",
    "@liusiqi-dev/dsh-subprocess-local": "workspace:*",
    "@liusiqi-dev/dsh-sandbox": "workspace:*",
    "@liusiqi-dev/dsh-sandbox-local": "workspace:*",
    "@liusiqi-dev/dsh-sandbox-policy": "workspace:*",
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/node-addon-system": "workspace:~",
    "@liusiqi-dev/dsh-session-projection": "workspace:*"
  }
}
