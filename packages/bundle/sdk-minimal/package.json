{
  "name": "@liusiqi-dev/sqh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@liusiqi-dev/cordis-plugin-timer": "workspace:~",
    "@liusiqi-dev/sqh-agent": "workspace:*",
    "@liusiqi-dev/sqh-agent-loop": "workspace:*",
    "@liusiqi-dev/sqh-deepseek-llm-api-extensions": "workspace:*",
    "@liusiqi-dev/sqh-invariants": "workspace:*",
    "@liusiqi-dev/sqh-jobs-local": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-llm-deepseek-api-key": "workspace:*",
    "@liusiqi-dev/sqh-llm-retry": "workspace:*",
    "@liusiqi-dev/sqh-mcp-resources": "workspace:*",
    "@liusiqi-dev/sqh-plugin-package-inventory-deepseek": "workspace:*",
    "@liusiqi-dev/sqh-sandbox-local": "workspace:*",
    "@liusiqi-dev/sqh-sandbox-policy": "workspace:*",
    "@liusiqi-dev/sqh-scope": "workspace:*",
    "@liusiqi-dev/sqh-sdk-app": "workspace:*",
    "@liusiqi-dev/sqh-sdk-jsonrpc-server": "workspace:*",
    "@liusiqi-dev/sqh-session": "workspace:*",
    "@liusiqi-dev/sqh-session-log-deepseek": "workspace:*",
    "@liusiqi-dev/sqh-session-persistence-jsonl": "workspace:*",
    "@liusiqi-dev/sqh-session-projection": "workspace:*",
    "@liusiqi-dev/sqh-session-title": "workspace:*",
    "@liusiqi-dev/sqh-subprocess-local": "workspace:*",
    "@liusiqi-dev/sqh-system-prompt": "workspace:*",
    "@liusiqi-dev/sqh-terminal": "workspace:*",
    "@liusiqi-dev/sqh-terminal-bash": "workspace:*",
    "@liusiqi-dev/sqh-tool-bash-persistent": "workspace:*",
    "@liusiqi-dev/sqh-tool-pwsh-persistent": "workspace:*",
    "@liusiqi-dev/sqh-tools": "workspace:*"
  },
  "peerDependencies": {
    "@liusiqi-dev/cordis": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~"
  }
}
