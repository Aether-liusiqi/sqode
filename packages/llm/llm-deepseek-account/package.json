    "@liusiqi-dev/dsh-launch-environment": "workspace:*",
    "@liusiqi-dev/dsh-deepseek-account": "workspace:*",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/dsh-llm": "workspace:*",
    "@liusiqi-dev/dsh-llm-deepseek": "workspace:*",
    "@liusiqi-dev/dsh-launch-environment": "workspace:*",
    "@liusiqi-dev/dsh-deepseek-account": "workspace:*",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/dsh-llm-deepseek-api-key": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@liusiqi-dev/dsh-deepseek-account": {
      "optional": true
    },
    "@liusiqi-dev/cordis-plugin-loader": {
      "optional": true
    }
  }
