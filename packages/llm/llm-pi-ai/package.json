    "@liusiqi-dev/sqh-authorization": "workspace:*",
    "@liusiqi-dev/sqh-credentials": "workspace:*",
    "@liusiqi-dev/sqh-fs": "workspace:*",
    "@liusiqi-dev/sqh-launch-environment": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-timeout": "workspace:*",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@liusiqi-dev/sqh-brand": "workspace:*",
    "@liusiqi-dev/sqh-util-values": "workspace:*",
    "@liusiqi-dev/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "devDependencies": {
    "@liusiqi-dev/cordis": "workspace:~",
    "@liusiqi-dev/sqh-attachment": "workspace:*",
    "@liusiqi-dev/sqh-authorization": "workspace:*",
    "@liusiqi-dev/sqh-credentials": "workspace:*",
    "@liusiqi-dev/sqh-fs": "workspace:*",
    "@liusiqi-dev/sqh-launch-environment": "workspace:*",
    "@liusiqi-dev/sqh-llm": "workspace:*",
    "@liusiqi-dev/sqh-llm-deepseek": "workspace:*",
    "@liusiqi-dev/sqh-llm-deepseek-api-key": "workspace:*",
    "@liusiqi-dev/sqh-timeout": "workspace:*",
    "@liusiqi-dev/sqh-http-proxy": "workspace:*",
    "@liusiqi-dev/cordis-plugin-loader": "workspace:~",
    "@liusiqi-dev/sqh-settings": "workspace:*"
  },
